<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- iisnode -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <rule name="Node" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Enable iisnode diagnostics/logs as needed -->
    <iisnode loggingEnabled="true" devErrorsEnabled="true" />

    <!-- Configure environment variables here for IIS -->
    <environmentVariables>
      <!-- Optional: when deployed as an IIS sub-application (e.g. /ticket-proxy) -->
      <environmentVariable name="APPLICATION_PREFIX" value="" />

      <!-- Optional: for nicer startup logs / endpoint URLs -->
      <environmentVariable name="PUBLIC_BASE_URL" value="https://ai.milgam.co.il" />

      <!-- Required: upstream endpoint + bearer token -->
      <environmentVariable name="UPSTREAM_URL" value="http://172.30.65.2/HelpE/Prod/api/Ticket/GetMonthlyTicketStats" />
      <environmentVariable name="AUTH_TOKEN" value="Bearer REPLACE_ME" />

      <!-- Optional -->
      <environmentVariable name="LOG_LEVEL" value="INFO" />
      <environmentVariable name="NODE_ENV" value="production" />
    </environmentVariables>
  </system.webServer>
</configuration>

